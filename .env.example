# Copy to .env and fill in. .env is gitignored — never commit it.

# Telegram delivery (from BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Bookmaker odds — https://the-odds-api.com (free tier)
ODDS_API_KEY=your_odds_api_key_here

# Anthropic — used by the LLM news/context layer
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# football-data.org — optional results source (free tier)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here

# Secret for protecting the HTTP run endpoints (if/when deployed)
RUN_API_KEY=your_secret_run_key_here

# Google Sheets performance mirror (optional).
# Leave GOOGLE_SHEETS_ID blank to keep the sync OFF. When set, betsu rewrites
# the sheet's Bets/Results/Summary tabs after each run. See
# docs/google_sheets_setup.md for the one-time service-account setup.
GOOGLE_SHEETS_ID=
# Path to the service-account JSON key (gitignored). Defaults to ./credentials.json
GOOGLE_CREDENTIALS_PATH=credentials.json
