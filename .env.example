# Copy to .env and fill in. .env is gitignored — never commit it.

# Telegram delivery (from BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Bookmaker odds — https://the-odds-api.com (free tier)
ODDS_API_KEY=your_odds_api_key_here
# BTTS (both-teams-to-score) prices come from the per-event endpoint, billed per
# event. They're cached per event so a fetch happens ~once per match. Set to 0
# to stop all per-event BTTS fetching if the odds budget gets tight mid-event.
BTTS_ENABLED=1
# Hours to reuse a cached BTTS price for an event (default 12).
BTTS_CACHE_HOURS=12

# Anthropic — used by the LLM news/context layer
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Turn the LLM context nudge on (default off). When 0, runs are unchanged.
# Web-search-grounded; needs ANTHROPIC_API_KEY. See tools/llm_context.py.
LLM_ENABLED=0

# football-data.org — auto-results source (free tier). With a key set, each
# grade run pulls finished WC scores and writes them to the Results tab under
# our team names, so bets settle without hand-typed scores. No-ops safely if
# the key is absent or the free tier won't serve the WC competition.
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
# Set to 0 to disable auto-results entirely (grade reads the Results tab as-is).
AUTO_RESULTS_ENABLED=1
# How many days back to ask football-data for finished fixtures each grade run.
RESULTS_LOOKBACK_DAYS=3

# --- Google Sheets store (required) -----------------------------------------
# Sheets is betsu's single source of truth. See docs/google_sheets_setup.md.
GOOGLE_SHEETS_ID=your_spreadsheet_id_here
# Local dev: path to the service-account JSON key file (gitignored).
GOOGLE_CREDENTIALS_PATH=credentials.json
# Deploy (Railway): paste the FULL service-account JSON here instead of a file.
# When set, it takes precedence over GOOGLE_CREDENTIALS_PATH.
GOOGLE_CREDENTIALS_JSON=

# --- Run endpoints + dashboard (app.py) -------------------------------------
# Shared secret n8n sends to POST /run/morning and /run/grade
# (header `X-Run-Key: <key>` or `?key=`). Required to enable the run endpoints.
RUN_API_KEY=your_secret_run_key_here
# HTTP Basic Auth for the dashboard (GET /). Leave blank for open local dev.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Tunables (optional; sensible defaults in config.py) --------------------
# Hours ahead the scheduled scan looks for not-yet-started fixtures (default 18).
SCAN_WINDOW_HOURS=18
